    LPF ALTER_EFFECT STR_VAR match_resource = C0RNH_2 resource = EVAL ~C0RNH_%hit_points%~ END
  COPY_EXISTING ~c0rnh_2.spl~ ~override/c0rnh_%hit_points%.spl~
    LPF ALTER_EFFECT STR_VAR match_resource = C0RNH_2 resource = EVAL ~C0RNH_%hit_points%~ END
END

